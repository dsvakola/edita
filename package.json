{
  "name": "edita",
  "productName": "Edita",
  "version": "1.3.0",
  "description": "Edita - a simple text/code editor for students, teachers and developers",
  "author": {
    "name": "Vidyasagar Robotics Academy",
    "email": "softinquiry@vsa.edu.in",
    "url": "https://vsa.edu.in/software/"
  },
