  "homepage": "https://vsa.edu.in/software/",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "art": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-installer-art.ps1",
    "icons": "tauri icon assets/icon.png -o src-tauri/icons",
    "start": "tauri dev",
    "dist": "pnpm run art && node scripts/installer-license.js && tauri build",
    "store-art": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-store-art.ps1",
    "msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-msix.ps1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2"
  }
