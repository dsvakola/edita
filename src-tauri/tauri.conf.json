{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edita",
  "mainBinaryName": "Edita",
  "version": "../package.json",
  "identifier": "in.edu.vsa.edita",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "pnpm run build:web",
    "beforeBuildCommand": "pnpm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vidyasagar Robotics Academy",
    "copyright": "Copyright 2026 Vidyasagar Robotics Academy",
    "category": "DeveloperTool",
    "shortDescription": "Edita - a simple text/code editor",
    "longDescription": "Edita - a simple text/code editor for students, teachers and developers. Developed by: Prof. Dattaraj S. Vidyasagar & Prof. Yash D. Vidyasagar, for Vidyasagar Robotics Academy.",
    "homepage": "https://vsa.edu.in/software/",
    "license": "GPL-3.0-only",
    "licenseFile": "../installer/license.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../installer/header.bmp",
        "sidebarImage": "../installer/sidebar.bmp",
        "installerHooks": "../installer/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
